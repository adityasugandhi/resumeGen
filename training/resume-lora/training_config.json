{
  "model": "mlx-community/Qwen2.5-7B-Instruct-4bit",
  "train": true,
  "data": "../training-data/chat-format",
  "fine_tune_type": "lora",
  "lora_parameters": {
    "rank": 16,
    "alpha": 32,
    "dropout": 0.05,
    "scale": 2.0
  },
  "num_layers": 16,
  "iters": 200,
  "learning_rate": 1e-05,
  "batch_size": 1,
  "grad_checkpoint": true,
  "max_seq_length": 4096,
  "steps_per_eval": 50,
  "val_batches": 10,
  "steps_per_report": 1,
  "adapter_path": "resume-lora",
  "save_every": 50,
  "seed": 42
}